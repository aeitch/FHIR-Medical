# Example Terraform Variables for ClinEfficiency UR Console Demo (GCP)
# Rename to demo.tfvars for custom deployment (NEVER commit secrets to version control)

project_id     = "parkkaro-prod"
region         = "us-central1"
prefix         = "clinefficiency"
subnet_cidr    = "10.0.0.0/24"
backend_image  = "us-docker.pkg.dev/cloudrun/container/hello"
frontend_image = "us-docker.pkg.dev/cloudrun/container/hello"
gemini_api_key = ""
